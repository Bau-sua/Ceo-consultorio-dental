---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const title = "Contacto — Pedí tu turno";
const description =
  "Pedí tu turno en el Centro de Salud C.E.O por WhatsApp. Ayacucho 1357, San Luis Capital. Lunes a viernes de 08:00 a 20:00 hs.";
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: "Contacto", item: `${site.url}/contacto/` },
  ],
});
const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  image: `${site.url}/og-image.png`,
  telephone: site.phoneTel,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address,
    addressLocality: "San Luis",
    addressRegion: "San Luis",
    addressCountry: "AR",
  },
  geo: { "@type": "GeoCoordinates", latitude: -33.2996, longitude: -66.3356 },
  openingHours: "Mo-Fr 08:00-20:00",
  url: `${site.url}/contacto/`,
  sameAs: [site.instagram],
});
---

<Layout title={title} description={description} path="/contacto/" extraSchemas={[breadcrumbSchema, localBusinessSchema]}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-50 to-brand-100/60 border-b border-slate-100">
    <div class="container-site py-14 sm:py-16 text-center max-w-2xl mx-auto">
      <p class="section-kicker mb-4">Contacto</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight">
        Pedí tu turno
      </h1>
      <p class="mt-5 text-lg text-ink-700 leading-relaxed">
        La forma más rápida de sacar turno es por WhatsApp: escribinos y te respondemos a la brevedad.
      </p>
      <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp mt-8 !px-8 !py-4 !text-base">
        <Icon name="whatsapp" class="w-5 h-5" />
        Escribinos por WhatsApp
      </a>
    </div>
  </section>

  <section class="container-site py-16 grid lg:grid-cols-2 gap-10">
    <!-- Datos de contacto -->
    <div class="space-y-6">
      <div class="card p-7">
        <h2 class="font-display font-semibold text-lg text-ink-900 mb-5">Datos de contacto</h2>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand-50 text-brand-600 shrink-0">
              <Icon name="whatsapp" class="w-5 h-5" />
            </span>
            <div>
              <p class="font-semibold text-ink-900">WhatsApp</p>
              <a href={site.whatsappUrl} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-800">
                {site.phoneDisplay}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand-50 text-brand-600 shrink-0">
              <Icon name="phone" class="w-5 h-5" />
            </span>
            <div>
              <p class="font-semibold text-ink-900">Teléfono</p>
              <a href={`tel:${site.phoneTel}`} class="text-brand-600 hover:text-brand-800">
                {site.phoneDisplay}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand-50 text-brand-600 shrink-0">
              <Icon name="mail" class="w-5 h-5" />
            </span>
            <div>
              <p class="font-semibold text-ink-900">Email</p>
              <a href={`mailto:${site.email}`} class="text-brand-600 hover:text-brand-800">
                {site.email}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand-50 text-brand-600 shrink-0">
              <Icon name="clock" class="w-5 h-5" />
            </span>
            <div>
              <p class="font-semibold text-ink-900">Horario</p>
              <p class="text-ink-500">Lunes a viernes · 08:00 a 20:00 hs</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand-50 text-brand-600 shrink-0">
              <Icon name="pin" class="w-5 h-5" />
            </span>
            <div>
              <p class="font-semibold text-ink-900">Dirección</p>
              <p class="text-ink-500">{site.address}, {site.city}</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Mapa -->
      <div class="card overflow-hidden">
        <div class="p-7 pb-0">
          <h2 class="font-display font-semibold text-lg text-ink-900 mb-2">Cómo llegar</h2>
          <a href={site.mapsLink} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-800 mb-4">
            <Icon name="pin" class="w-4 h-4" />
            Abrir en Google Maps
          </a>
        </div>
        <iframe
          title="Mapa de ubicación del Centro de Salud C.E.O"
          src={site.mapsEmbed}
          class="w-full h-72 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
