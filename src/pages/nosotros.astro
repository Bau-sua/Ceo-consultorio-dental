---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site, team, stats } from "../data/site";

const title = "Nosotros — Conocé nuestra clínica y equipo";
const description =
  "Más de 10 años de trayectoria en San Luis. Conocé a los 16 especialistas del Centro de Salud C.E.O: odontólogos, médicos y profesionales de la salud en un mismo lugar.";
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: "Nosotros", item: `${site.url}/nosotros/` },
  ],
});

const areas = ["Odontología", "Medicina", "Salud"] as const;
const teamByArea = (area: string) => team.filter((m) => m.area === area);
const initials = (name: string) => {
  const clean = name
    .replace("Dra. ", "")
    .replace("Dr. ", "")
    .replace("Lic. ", "")
    .replace("Fga. ", "");
  return `${clean.split(" ")[0][0]}${clean.split(" ").pop()?.[0] ?? ""}`;
};
---

<Layout title={title} description={description} path="/nosotros/" extraSchemas={[breadcrumbSchema]}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-50 to-brand-100/60 border-b border-slate-100">
    <div class="container-site py-16 sm:py-20 max-w-3xl mx-auto text-center">
      <p class="section-kicker mb-4">Nosotros</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight">
        Nuestra clínica está hecha para que puedas sonreír todo el tiempo
      </h1>
      <p class="mt-5 text-lg text-ink-700 leading-relaxed">
        Todas las especialidades, desde las más simples hasta las más complejas, en un mismo
        lugar para tu comodidad. Ese es nuestro compromiso con San Luis.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-brand-950 text-white" aria-label="Números de la clínica">
    <div class="container-site grid grid-cols-2 lg:grid-cols-4 gap-8 py-12">
      {
        stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-4xl sm:text-5xl font-bold text-brand-300">{s.value}</p>
            <p class="mt-2 text-sm text-brand-100/80">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Historia -->
  <section class="container-site py-16 sm:py-20 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="section-kicker mb-3">Nuestra historia</p>
      <h2 class="section-title">Más de {site.years} años cuidando sonrisas</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Lo que empezó como un consultorio odontológico creció hasta convertirse en un centro de
        salud integral: hoy reúne odontólogos, médicos, nutricionistas, kinesiólogos y
        fonoaudiólogos trabajando en equipo.
      </p>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Nuestro objetivo sigue siendo el mismo que el primer día: que cada paciente entre
        tranquilo, sin temores, y salga con la seguridad de estar en buenas manos.
      </p>
      <ul class="mt-8 space-y-4">
        {
          [
            "Tratamiento personalizado para cada paciente",
            "Tecnología y protocolos actualizados",
            "Atención por obras sociales y particulares",
            "Urgencias atendidas el mismo día",
          ].map((v) => (
            <li class="flex items-center gap-3 text-ink-900 font-medium">
              <span class="grid place-items-center w-8 h-8 rounded-full bg-brand-50 text-brand-600 shrink-0">
                <Icon name="check" class="w-4 h-4" />
              </span>
              {v}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-[2rem] bg-gradient-to-br from-brand-100 to-brand-200 p-10 sm:p-14 text-brand-900">
      <Icon name="tooth" class="w-14 h-14 text-brand-600" />
      <p class="mt-6 font-display text-2xl font-semibold leading-snug">
        "Trabajamos para subir el porcentaje de pacientes satisfechos todos los días"
      </p>
    </div>
  </section>

  <!-- Video del equipo -->
  <section class="container-site py-16 sm:py-20">
    <div class="max-w-2xl mb-12">
      <p class="section-kicker mb-3">Conocé al equipo</p>
      <h2 class="section-title">Un equipo que trabaja junto por tu bienestar</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Somos profesionales de distintas áreas que nos coordinamos para brindarte la mejor atención posible.
      </p>
    </div>
    <div class="rounded-2xl overflow-hidden shadow-xl">
      <iframe
        src="https://drive.google.com/file/d/106h5sYwsgBQPfGeqNYUsmyZJz85hFd0Y/preview"
        width="100%"
        height="100%"
        class="w-full aspect-video border-0"
        allow="autoplay"
        allowfullscreen
        loading="lazy"
        title="Video del equipo del Centro de Salud C.E.O"
      ></iframe>
    </div>
  </section>

  <!-- Equipo -->
  <section class="bg-slate-50 border-y border-slate-100" aria-label="Equipo">
    <div class="container-site py-16 sm:py-20">
      <div class="max-w-2xl mb-12">
        <p class="section-kicker mb-3">El equipo</p>
        <h2 class="section-title">Conocé a nuestros especialistas</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">
          {team.length} profesionales certificados, desde estética dental hasta cirugía
          maxilofacial, pasando por medicina, nutrición y terapias.
        </p>
      </div>

      {
        areas.map((area) => (
          <div class="mb-14 last:mb-0">
            <h3 class="font-display text-2xl font-semibold text-ink-900 mb-6 flex items-center gap-3">
              {area}
              <span class="h-px flex-1 bg-slate-200"></span>
            </h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {
                teamByArea(area).map((m) => (
                  <article class="card p-6 text-center">
                    {m.photo ? (
                      <img src={m.photo} alt={m.name} class="mx-auto rounded-full object-cover border-2 border-brand-100" style="width:4.5rem;height:4.5rem" loading="lazy" />
                    ) : (
                      <span class="mx-auto grid place-items-center w-18 h-18 rounded-full bg-brand-100 text-brand-700 font-display font-bold text-xl" style="width:4.5rem;height:4.5rem">
                        {initials(m.name)}
                      </span>
                    )}
                    <h4 class="mt-4 font-display font-semibold text-ink-900">{m.name}</h4>
                    <p class="text-sm font-semibold text-brand-600 mt-1">{m.role}</p>
                    <p class="text-xs text-ink-500 mt-2 leading-relaxed">{m.specialty}</p>
                  </article>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="container-site py-16 text-center max-w-2xl mx-auto">
    <h2 class="section-title">¿Querés conocer tu caso con un especialista?</h2>
    <p class="mt-4 text-ink-700 leading-relaxed">
      Agendá una consulta y te derivamos al profesional indicado según tu necesidad.
    </p>
    <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp mt-8 !px-8 !py-4 !text-base">
      <Icon name="whatsapp" class="w-5 h-5" />
      Pedí tu turno
    </a>
  </section>
</Layout>
