};

const stroke = paths[name] ?? paths.tooth;
const isFilled = name === "whatsapp" || name === "star";
---

<svg
  viewBox="0 0 24 24"
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width="1.7"
  class={className}
  aria-hidden="true"
  set:html={stroke}
/>
