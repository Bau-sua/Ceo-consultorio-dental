---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/especialidades/", label: "Especialidades" },
  { href: "/nosotros/", label: "Nosotros" },
  { href: "/blog/", label: "Blog" },
  { href: "/contacto/", label: "Contacto" },
];
---

<!-- Top bar: datos de contacto siempre visibles -->
<div class="bg-brand-950 text-brand-100 text-xs sm:text-sm">
  <div class="container-site flex items-center justify-between gap-4 py-2">
    <div class="flex items-center gap-5 min-w-0">
      <span class="hidden sm:flex items-center gap-1.5">
        <Icon name="clock" class="w-4 h-4 text-brand-300" />
        {site.hours}
      </span>
      <span class="flex items-center gap-1.5 truncate">
        <Icon name="pin" class="w-4 h-4 text-brand-300 shrink-0" />
        <span class="truncate">{site.address}, San Luis</span>
      </span>
    </div>
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener"
      class="flex items-center gap-1.5 font-semibold text-white hover:text-brand-200 transition-colors shrink-0"
    >
      <Icon name="whatsapp" class="w-4 h-4 text-[#25D366]" />
      {site.phoneDisplay}
    </a>
  </div>
</div>

<!-- Header principal -->
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100 shadow-sm">
  <div class="container-site flex items-center justify-between py-3">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="Ir al inicio">
      <span
        class="grid place-items-center w-11 h-11 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-md shadow-brand-500/30 group-hover:scale-105 transition-transform"
      >
        <Icon name="tooth" class="w-6 h-6" />
      </span>
      <span class="leading-tight">
        <span class="block font-display font-bold text-ink-900 text-lg">
          Centro de Salud <span class="text-brand-600">C.E.O</span>
        </span>
        <span class="block text-[11px] uppercase tracking-[0.18em] text-ink-500">
          {site.tagline}
        </span>
      </span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ink-700 hover:text-brand-700 transition-colors relative after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-0 after:bg-brand-500 after:transition-all hover:after:w-full"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA desktop -->
    <div class="hidden lg:flex items-center gap-3">
      <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp !px-5 !py-2.5">
        <Icon name="whatsapp" class="w-4 h-4" />
        Pedí tu turno
      </a>
    </div>

    <!-- Botón menú móvil -->
    <button
      id="menu-toggle"
      class="lg:hidden grid place-items-center w-11 h-11 rounded-xl border border-slate-200 text-ink-900"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="icon-open"><Icon name="menu" class="w-6 h-6" /></span>
      <span id="icon-close" class="hidden"><Icon name="close" class="w-6 h-6" /></span>
    </button>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white">
    <nav class="container-site flex flex-col py-3" aria-label="Menú móvil">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="py-3 text-base font-medium text-ink-900 border-b border-slate-50 last:border-0 hover:text-brand-700"
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp mt-4">
        <Icon name="whatsapp" class="w-5 h-5" />
        Pedí tu turno por WhatsApp
      </a>
      <a href={`tel:${site.phoneTel}`} class="btn-secondary mt-3">
        <Icon name="phone" class="w-5 h-5" />
        {site.phoneDisplay}
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isOpen));
      iconOpen?.classList.toggle("hidden", !isOpen);
      iconClose?.classList.toggle("hidden", isOpen);
    });
  }
</script>
